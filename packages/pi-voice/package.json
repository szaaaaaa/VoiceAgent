{
  "name": "@voice-agent/pi-voice",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Hot-pluggable full-duplex /voice extension package for Pi Coding Agent powered by local VoiceAgent speech core",
  "keywords": [
    "pi-package",
    "voice",
    "asr",
    "tts",
    "full-duplex"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@voice-agent/protocol": "*",
    "@voice-agent/speech": "*",
    "@voice-agent/interaction": "*",
    "@voice-agent/metrics": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  }
}
