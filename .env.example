# ==============================================================================
# VoiceAgent Environment Configuration Template
# Copy this file to `.env` for local development. NEVER commit `.env` to Git.
# ==============================================================================

# Local WebSocket Bridge (bind to localhost only per security policy)
VOICE_AGENT_WS_HOST=127.0.0.1
VOICE_AGENT_WS_PORT=8765

# GPU & Model Cache Settings
CUDA_VISIBLE_DEVICES=0
HF_HOME=./models/hf_cache
VOICE_AGENT_CONFIG=./configs/default.yaml

# Pi Agent / Online LLM Provider API Keys (configured locally as needed)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Telemetry & Experiment Logging (disabled raw audio recording by default)
VOICE_AGENT_SAVE_RAW_AUDIO=false
VOICE_AGENT_LOG_LEVEL=INFO
