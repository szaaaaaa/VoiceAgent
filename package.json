{
  "name": "voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Full-duplex local desktop voice agent powered by Pi Agent, Nemotron Streaming ASR, Causal Turn Adapter, and Qwen3-TTS",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "gui": "vite --config apps/desktop/vite.config.ts",
    "desktop": "npm run build:gui && electron apps/desktop/electron-main.cjs",
    "desktop:gpu": "powershell -ExecutionPolicy Bypass -File ./Start-VoiceAgent.ps1 -GpuModels",
    "build:gui": "vite build --config apps/desktop/vite.config.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
